import { Router } from 'express';
import { z } from 'zod';
import { fetchWebPage } from '../lib/httpClient.js';
import { requireAuth } from '../middleware/auth.js';
import {
  AI_PROVIDERS,
  callAiProvider,
  listAiProviderModels,
} from '../lib/ai.js';

const aiRouter = Router();

const orchestrateSchema = z.object({
  task: z.string().min(3),
  goal: z.string().optional(),
  url: z.string().url().optional(),
  provider: z.string().optional(),
});

const chatSchema = z.object({
  provider: z.enum(['openai', 'anthropic', 'gemini', 'deepseek', 'groq', 'openrouter', 'mistral']).default('openai'),
  model: z.string().optional(),
  messages: z.array(
    z.object({
      role: z.enum(['user', 'assistant', 'system']),
      content: z.string().min(1),
    }),
  ).min(1),
  temperature: z.number().min(0).max(2).optional().default(0.7),
  maxTokens: z.number().int().positive().max(8192).optional(),
});

aiRouter.get('/providers', requireAuth, (_req, res) => {
  res.json(listAiProviderModels());
});

aiRouter.get('/models', requireAuth, (req, res) => {
  const provider = String(req.query.provider ?? 'all');
  res.json(listAiProviderModels(provider === 'all' ? undefined : provider));
});

aiRouter.post('/chat', requireAuth, async (req, res) => {
  try {
    const body = chatSchema.parse(req.body);
    const provider = body.provider;
    const model = body.model ?? AI_PROVIDERS[provider].defaultModels[0];

    const result = await callAiProvider({
      provider,
      model,
      messages: body.messages,
      temperature: body.temperature,
      maxTokens: body.maxTokens,
    });

    res.json(result);
  } catch (error) {
    res.status(400).json({ error: error instanceof Error ? error.message : 'Unable to complete AI request.' });
  }
});

aiRouter.post('/orchestrate', requireAuth, async (req, res) => {
  try {
    const body = orchestrateSchema.parse(req.body);
    const plan = [
      { step: 'understand', description: `Interpret the objective: ${body.task}` },
      { step: 'gather-data', description: body.url ? `Fetch information from ${body.url}` : 'Search available sources for relevant context' },
      { step: 'act', description: `Use provider ${body.provider ?? 'default'} to perform the requested action` },
      { step: 'respond', description: 'Return the result and summarize actions taken' },
    ];

    let pageContext: unknown = null;
    if (body.url) {
      pageContext = await fetchWebPage(body.url);
    }

    res.json({
      ok: true,
      task: body.task,
      goal: body.goal ?? 'General internet automation',
      provider: body.provider ?? 'default',
      plan,
      context: pageContext,
    });
  } catch (error) {
    res.status(400).json({ error: error instanceof Error ? error.message : 'Unable to orchestrate task.' });
  }
});

export default aiRouter;
